# Homepage environment variables
# Copy this file to .env (same directory) and fill in real values.
# This file is safe to commit. .env is gitignored.
#
# Deploy: copy .env to /opt/homepage/config/.env on CT102 (10.27.27.112)

# Proxmox service widgets (username/password auth)
# Can use root@pam password or a dedicated API token value as the password
HOMEPAGE_VAR_PVE1_PASSWORD=
HOMEPAGE_VAR_PVE2_PASSWORD=
HOMEPAGE_VAR_PVE3_PASSWORD=

# Proxmox status badges — proxmox.yaml (API token auth)
# Token is cluster-wide — create once at Datacenter > Permissions > API Tokens
#   User: root@pam, Token ID: homepage, Privilege Separation: unchecked
# Token format: root@pam!homepage
HOMEPAGE_VAR_PROXMOX_TOKEN=
HOMEPAGE_VAR_PROXMOX_TOKEN_SECRET=

# UniFi — local admin account (not UniFi Cloud)
HOMEPAGE_VAR_UNIFI_USERNAME=
HOMEPAGE_VAR_UNIFI_PASSWORD=

# AdGuard Home
HOMEPAGE_VAR_ADGUARD_PASSWORD=

# Nginx Proxy Manager
HOMEPAGE_VAR_NPM_PASSWORD=

# Jellyfin — Dashboard > Administration > API Keys
HOMEPAGE_VAR_JELLYFIN_API_KEY=

# Audiobookshelf — Settings > Users > your user > API Token
HOMEPAGE_VAR_AUDIOBOOKSHELF_API_KEY=

# Arr stack — each app: Settings > General > API Key
HOMEPAGE_VAR_OVERSEERR_API_KEY=
HOMEPAGE_VAR_SONARR_API_KEY=
HOMEPAGE_VAR_RADARR_API_KEY=
HOMEPAGE_VAR_PROWLARR_API_KEY=

# qBittorrent
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=

# Paperless-ngx — user profile > API Token
HOMEPAGE_VAR_PAPERLESS_API_KEY=

# Uptime Kuma — Settings > Status Pages > slug field
HOMEPAGE_VAR_UPTIMEKUMA_SLUG=
